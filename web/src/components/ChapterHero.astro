---
/**
 * ChapterHero — owned by Surya.
 * Minimal literary chapter masthead with unbroken, properly proportioned headings.
 */
interface Props {
  name: string;
  nickname?: string;
  hook: string;
  act: "moon" | "mars" | "deep";
  index?: number;
  total?: number;
  mission?: string;
  site?: string;
  distanceKm?: number;
  lightTimeSec?: number;
}

const {
  name,
  nickname,
  hook,
  act,
  index = 1,
  total = 13,
  site,
  distanceKm = 384400,
  lightTimeSec = 1.28,
} = Astro.props;

const ACT_TITLE = {
  moon: "The Moon",
  mars: "Mars",
  deep: "Deep Space",
}[act];

const padIdx = String(index).padStart(2, "0");
const padTotal = String(total).padStart(2, "0");

function fmtDistance(km: number): string {
  if (km >= 1e9) return `${(km / 1e9).toFixed(2)} billion km`;
  if (km >= 1e6) return `${(km / 1e6).toFixed(1)} million km`;
  return `${Math.round(km).toLocaleString("en-US")} km`;
}

function fmtLight(sec: number): string {
  if (sec < 60) return `${sec.toFixed(2)}s signal delay`;
  if (sec < 3600) return `${Math.floor(sec / 60)}m ${Math.round(sec % 60)}s signal delay`;
  return `${Math.floor(sec / 3600)}h ${Math.round((sec % 3600) / 60)}m signal delay`;
}
---
<header class="chapter-hero" data-act={act}>
  <div class="eyebrow" data-reveal>
    <span class="ch-num">Chapter {padIdx} of {padTotal}</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>{ACT_TITLE}</span>
    {site && (
      <>
        <span class="sep" aria-hidden="true">·</span>
        <span>{site}</span>
      </>
    )}
  </div>

  <h1 class="title" data-reveal>{nickname ?? name}</h1>

  <p class="hook" data-reveal>“{hook}”</p>

  <p class="telemetry-line" data-reveal>
    {fmtDistance(distanceKm)} from Earth · {fmtLight(lightTimeSec)}
  </p>
</header>

<style>
  .chapter-hero {
    max-width: 960px;
    margin-inline: auto;
    padding: var(--s-20) var(--s-6) var(--s-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s-5);
  }

  .chapter-hero::after {
    content: "";
    display: block;
    width: 100%;
    max-width: var(--measure);
    height: 1px;
    margin-top: var(--s-5);
    background: var(--c-line);
  }

  .eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    font: 400 var(--t-xs)/1.4 var(--f-record);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
  }
  .ch-num {
    color: var(--c-accent);
  }
  .sep {
    opacity: 0.35;
  }

  .title {
    font: 700 clamp(1.85rem, 1.45rem + 2.1vw, 3.0rem)/1.22 var(--f-voice);
    color: var(--c-ink);
    margin: var(--s-2) 0 0;
    letter-spacing: 0em;
    word-spacing: 0.02em;
    max-width: none;
    word-break: keep-all;
    overflow-wrap: normal;
    hyphens: none;
    text-wrap: balance;
  }

  .hook {
    font: italic 400 var(--t-lg)/var(--lh-voice) var(--f-voice);
    color: var(--c-accent);
    margin: 0;
    letter-spacing: 0.004em;
    word-spacing: 0.03em;
    max-width: 54ch;
    text-wrap: balance;
  }

  .telemetry-line {
    margin: var(--s-2) 0 0;
    font: 400 var(--t-xs)/1.4 var(--f-record);
    letter-spacing: 0.06em;
    color: var(--c-ink-dim);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 680px) {
    .chapter-hero {
      padding: var(--s-12) var(--s-4) var(--s-6);
      gap: var(--s-4);
    }
    .title {
      font-size: clamp(1.45rem, 1.15rem + 2.5vw, 2.1rem);
    }
  }

  @media (max-width: 380px) {
    .chapter-hero {
      padding-inline: var(--s-3);
    }
    .eyebrow {
      gap: 6px;
      letter-spacing: 0.08em;
    }
  }
</style>
