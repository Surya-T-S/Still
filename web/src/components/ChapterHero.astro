---
/** ChapterHero — owned by Surya. Props are the contract with index.astro. */
interface Props {
  name: string;        // official name
  nickname?: string;   // big title if present
  hook: string;        // Nandana's first line
  act: "moon" | "mars" | "deep";
  lineArt: string;     // raw SVG markup (passed via lineArt())
}
const { name, nickname, hook, act, lineArt } = Astro.props;
---
<header class="hero" data-act={act}>
  <div class="art-wrap">
    <div class="halo" aria-hidden="true"></div>
    <div class="art" data-draw set:html={lineArt} />
  </div>
  <p class="kicker" data-reveal>{nickname ? name : act.toUpperCase()}</p>
  <h2 class="title" data-reveal>{nickname ?? name}</h2>
  <p class="hook" data-reveal>{hook}</p>
</header>

<style>
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-4);
    padding: var(--s-24) var(--s-6) var(--s-12);
  }
  .art-wrap {
    position: relative;
    display: grid;
    place-items: center;
    margin-bottom: var(--s-4);
  }
  .halo {
    position: absolute;
    width: 72%;
    height: 72%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--c-glow), transparent 70%);
    pointer-events: none;
  }
  .art {
    position: relative;
    width: min(520px, 84vw);
    color: var(--c-accent);
  }
  .art :global(svg) { width: 100%; height: auto; display: block; }
  .kicker {
    font: 500 var(--t-xs)/1 var(--f-record);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
    margin: 0;
  }
  .title {
    font: 400 var(--t-hero)/var(--lh-tight) var(--f-voice);
    margin: 0;
    max-width: 14ch;
  }
  .hook {
    font: italic 400 var(--t-lg)/var(--lh-voice) var(--f-voice);
    color: var(--c-accent);
    margin: var(--s-2) 0 0;
    max-width: 34ch;
  }
</style>
