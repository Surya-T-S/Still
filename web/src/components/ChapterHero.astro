---
/**
 * ChapterHero — owned by Surya.
 * Minimal literary chapter masthead with scientific Space Mono proportions.
 * Uncluttered: chapter number, sector, title, italic hook, and a quiet
 * single-line distance/signal-delay subtitle.
 */
interface Props {
  name: string;
  nickname?: string;
  hook: string;
  act: "moon" | "mars" | "deep";
  index?: number;
  total?: number;
  mission?: string;
  site?: string;
  distanceKm?: number;
  lightTimeSec?: number;
}

const {
  name,
  nickname,
  hook,
  act,
  index = 1,
  total = 13,
  site,
  distanceKm = 384400,
  lightTimeSec = 1.28,
} = Astro.props;

const ACT_TITLE = {
  moon: "The Moon",
  mars: "Mars",
  deep: "Deep Space",
}[act];

const padIdx = String(index).padStart(2, "0");
const padTotal = String(total).padStart(2, "0");

function fmtDistance(km: number): string {
  if (km >= 1e9) return `${(km / 1e9).toFixed(2)} billion km`;
  if (km >= 1e6) return `${(km / 1e6).toFixed(1)} million km`;
  return `${Math.round(km).toLocaleString("en-US")} km`;
}

function fmtLight(sec: number): string {
  if (sec < 60) return `${sec.toFixed(2)}s signal delay`;
  if (sec < 3600) return `${Math.floor(sec / 60)}m ${Math.round(sec % 60)}s signal delay`;
  return `${Math.floor(sec / 3600)}h ${Math.round((sec % 3600) / 60)}m signal delay`;
}
---
<header class="chapter-hero" data-act={act}>
  <div class="eyebrow" data-reveal>
    <span class="ch-num">Chapter {padIdx} of {padTotal}</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>{ACT_TITLE}</span>
    {site && (
      <>
        <span class="sep" aria-hidden="true">·</span>
        <span>{site}</span>
      </>
    )}
  </div>

  <h1 class="title" data-reveal>{nickname ?? name}</h1>

  <p class="hook" data-reveal>“{hook}”</p>

  <p class="telemetry-line" data-reveal>
    {fmtDistance(distanceKm)} from Earth · {fmtLight(lightTimeSec)}
  </p>
</header>

<style>
  .chapter-hero {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--s-20) var(--s-6) var(--s-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s-5);
    border-bottom: 1px solid var(--c-line);
  }

  .eyebrow {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px;
    font: 400 var(--t-xs)/1.4 var(--f-record);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
  }
  .ch-num {
    color: var(--c-accent);
  }
  .sep {
    opacity: 0.35;
  }

  .title {
    font: 700 var(--t-hero)/var(--lh-tight) var(--f-voice);
    color: var(--c-ink);
    margin: var(--s-2) 0 0;
    letter-spacing: -0.015em;
    word-spacing: 0.02em;
    max-width: 20ch;
  }

  .hook {
    font: italic 400 var(--t-lg)/var(--lh-voice) var(--f-voice);
    color: var(--c-accent);
    margin: 0;
    letter-spacing: 0.004em;
    word-spacing: 0.03em;
    max-width: 38ch;
  }

  .telemetry-line {
    margin: var(--s-2) 0 0;
    font: 400 var(--t-xs)/1.4 var(--f-record);
    letter-spacing: 0.08em;
    color: var(--c-ink-dim);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 600px) {
    .chapter-hero {
      padding-top: var(--s-12);
      padding-bottom: var(--s-8);
    }
  }
</style>
