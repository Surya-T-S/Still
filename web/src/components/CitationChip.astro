---
/** CitationChip — owned by C. Links any fact to its archive record. */
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="chip" href={href} target="_blank" rel="noopener">
  <span aria-hidden="true">↗</span> {label}
</a>

<style>
  .chip { display: inline-flex; gap: var(--s-2); align-items: center; font: 500 var(--t-xs)/1 var(--f-record); letter-spacing: 0.08em; color: var(--c-ink-dim); text-decoration: none; border: 1px solid var(--c-line); border-radius: var(--r-pill); padding: var(--s-2) var(--s-3); transition: color var(--d-fast) var(--ease-out), border-color var(--d-fast) var(--ease-out), transform var(--d-fast) var(--ease-out); }
  .chip:hover, .chip:focus-visible { color: var(--c-accent); border-color: var(--c-accent); transform: translateY(-1px); }
</style>
