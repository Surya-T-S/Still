---
/**
 * RecordCard — owned by Vrindha (Platform & Structure).
 * Quiet, minimal archival colophon at the foot of the story.
 */
import CitationChip from "./CitationChip.astro";

interface Stat {
  label: string;
  value: string;
  comparison?: string;
  sourceUrl: string;
}

interface Props {
  stats: Stat[];
  lastContact: string;
  site?: string;
  nssdcaId: string;
  nssdcaUrl: string;
  legacy?: string;
}

const { stats, lastContact, nssdcaId, nssdcaUrl } = Astro.props;
---
<footer class="record-colophon" aria-label="Mission specifications" data-reveal>
  <dl class="stats-row">
    {stats.slice(0, 3).map((s) => (
      <div class="stat-item">
        <dt>{s.label}</dt>
        <dd>{s.value}</dd>
      </div>
    ))}
  </dl>

  <div class="colophon-meta">
    <span>Last contact {lastContact} · Silent <strong data-silent-since={lastContact}>—</strong> days</span>
    <CitationChip href={nssdcaUrl} label={`NSSDCA ${nssdcaId}`} />
  </div>
</footer>

<style>
  .record-colophon {
    max-width: var(--measure);
    margin: var(--s-16) auto var(--s-12);
    padding: var(--s-8) var(--s-6) 0;
    border-top: 1px solid var(--c-line);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
    margin: 0;
    padding: 0;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-item dt {
    font: 400 0.68rem/1.3 var(--f-record);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
  }

  .stat-item dd {
    font: 700 var(--t-md)/1.3 var(--f-voice);
    color: var(--c-ink);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .colophon-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line);
    font: 400 var(--t-xs)/1.5 var(--f-record);
    color: var(--c-ink-dim);
    font-variant-numeric: tabular-nums;
  }

  .colophon-meta strong {
    color: var(--c-ink);
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .stats-row {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
</style>
