---
/**
 * SignalHUD — owned by Vrindha (Platform & Structure).
 * Accessible live telemetry region (visual readout is integrated directly into
 * the unified Top Editorial Bar in TrajectoryNav so there is zero floating clutter).
 */
---
<div
  id="signal-hud"
  class="sr-only-hud"
  role="region"
  aria-live="polite"
  aria-label="Active chapter signal telemetry"
>
  <span data-hud-where>Earth</span>
  <span data-hud-dist>0 km</span>
  <span data-hud-light>0.00 s</span>
</div>

<style>
  .sr-only-hud {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
