---
/**
 * Starfield — owned by Surya.
 * Refined, ultra-responsive, zero-clutter 3D starfield engine:
 * 1. VACUUM MODE (Dark):
 *    - Instant, tactile click response on STILL:
 *      * Clicks 1..4: Stars remain anchored in place while their radial light-lines
 *        respond immediately with a silky spring kick (and smoothly retract if paused).
 *      * Click 5+: Seamless cascade into full-space Explosion (starts slowly, surges
 *        into high-speed 360° flight with tapered light-trails, and coasts down smoothly).
 *    - Zero middle-screen clutter: Uses area-uniform radial distribution (`sqrt(random)`)
 *      with a protected inner exclusion zone so stars never bunch up in the center.
 * 2. PAPER MODE (Light):
 *    - Strictly scroll-driven (`sy`) with whisper-faint speck visibility (`0.14` alpha).
 */
---
<canvas class="stars" aria-hidden="true" data-stars></canvas>

<style>
  .stars {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: var(--z-stars);
    pointer-events: none;
  }
</style>

<script>
  const c = document.querySelector<HTMLCanvasElement>("[data-stars]")!;
  const ctx = c.getContext("2d")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  type Star = {
    x: number;
    y: number;
    paperX: number;
    paperY: number;
    r: number;
    z: number;
    a: number;
    fadeIn: number;
    phase: number;
    speed: number;
    color: string;
    inkColor: string;
    flare: boolean;
  };

  const VACUUM_PALETTE = ["#f2efe9", "#d8e6f7", "#f5e1c4", "#bdd2ec"];
  const PAPER_PALETTE = ["#3d3124", "#524334", "#4a3b2c"];

  let stars: Star[] = [];
  let w = 0;
  let h = 0;
  let raf = 0;
  let lastFrameTime = 0;

  // Pointer parallax state (Vacuum mode only)
  let ptrX = 0;
  let ptrY = 0;
  let curX = 0;
  let curY = 0;

  // Page-scroll physics state
  let lastScrollY = typeof window !== "undefined" ? window.scrollY : 0;
  let vacuumVelY = 0;
  let warpImpulseY = 0;

  // Responsive Two-Stage Click-Charge & Explosion State
  const EXPLOSION_THRESHOLD = 5;
  let clickCount = 0;
  let lastClickTime = 0;

  // Stage 1: Responsive stationary line expansion
  let lineTarget = 0;
  let lineStretch = 0;
  let lineStretchVel = 0;

  // Stage 2: Continuous cascade reservoir (slow start -> rapid surge -> smooth coast)
  let blastFuel = 0;
  let blastPreCharge = 0;
  let radialVel = 0;
  let shockwaveRadius = 0;
  let shockwaveAlpha = 0;

  /**
   * Generates a position that avoids clustering in the dead center of the viewport
   * using area-uniform annulus sampling.
   */
  function sampleBalancedPosition(forRespawn: boolean): { x: number; y: number } {
    const cx = w * 0.5;
    const cy = h * 0.5;

    if (!forRespawn || radialVel < 2.2) {
      // Full-viewport uniform placement, nudging any dead-center hits outward
      let x = Math.random() * w;
      let y = Math.random() * h;
      const minCenterClearance = Math.min(w, h) * 0.11;
      const dx = x - cx;
      const dy = y - cy;
      const d = Math.hypot(dx, dy);
      if (d < minCenterClearance) {
        const ang = Math.random() * Math.PI * 2;
        const pushR = minCenterClearance + Math.random() * Math.min(w, h) * 0.28;
        x = cx + Math.cos(ang) * pushR;
        y = cy + Math.sin(ang) * pushR;
      }
      return { x, y };
    }

    // During active radial flight: area-uniform annulus (sqrt distribution)
    // outside the central reading/title zone so the middle NEVER gets cluttered!
    const minR = Math.min(w, h) * 0.14;
    const maxR = Math.hypot(cx, cy) * 0.62;
    const u = Math.random();
    const rad = Math.sqrt(u * (maxR * maxR - minR * minR) + minR * minR);
    const angle = Math.random() * Math.PI * 2;
    return {
      x: cx + Math.cos(angle) * rad,
      y: cy + Math.sin(angle) * rad,
    };
  }

  function spawnStar(i: number): Star {
    const layer = i % 9 === 0 ? 3 : i % 3 === 0 ? 2 : 1;
    const z = layer === 3 ? 0.92 : layer === 2 ? 0.52 : 0.24;
    const r =
      layer === 3
        ? Math.random() * 0.9 + 1.1
        : layer === 2
          ? Math.random() * 0.55 + 0.65
          : Math.random() * 0.35 + 0.35;

    const pos = sampleBalancedPosition(false);

    return {
      x: pos.x,
      y: pos.y,
      paperX: Math.random() * w,
      paperY: Math.random() * h,
      r,
      z,
      a: layer === 3 ? 0.90 : layer === 2 ? 0.56 : 0.28,
      fadeIn: 1,
      phase: Math.random() * Math.PI * 2,
      speed: Math.random() * 0.016 + 0.004,
      color: VACUUM_PALETTE[i % VACUUM_PALETTE.length],
      inkColor: PAPER_PALETTE[i % PAPER_PALETTE.length],
      flare: layer === 3 && i % 18 === 0,
    };
  }

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth;
    h = innerHeight;
    c.width = w * dpr;
    c.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // Refined, uncrowded star count (max 240)
    const n = Math.round(Math.min(240, (w * h) / 6200));
    stars = Array.from({ length: n }, (_, i) => spawnStar(i));
  }

  function drawPaperGraticule(sy: number) {
    const gridStep = 140;
    const offsetY = ((-sy * 0.35) % gridStep + gridStep) % gridStep;

    ctx.save();
    ctx.strokeStyle = "rgba(61, 49, 36, 0.055)";
    ctx.lineWidth = 1;

    for (let x = gridStep * 0.5; x < w; x += gridStep) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }

    for (let y = offsetY; y < h; y += gridStep) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    ctx.strokeStyle = "rgba(61, 49, 36, 0.14)";
    const tickStep = 28;
    const tickOffset = ((-sy * 0.5) % tickStep + tickStep) % tickStep;
    for (let y = tickOffset; y < h; y += tickStep) {
      const isMajor = Math.round((y - tickOffset) / tickStep) % 5 === 0;
      const len = isMajor ? 10 : 5;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(len, y);
      ctx.moveTo(w - len, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    ctx.restore();
  }

  function draw(t = 0) {
    const now = t || performance.now();
    const dt = lastFrameTime ? Math.min(2.2, Math.max(0.25, (now - lastFrameTime) / 16.667)) : 1;
    lastFrameTime = now;

    const isPaper = document.documentElement.dataset.theme === "light";
    const sy = still ? 0 : window.scrollY;

    const scrollDelta = sy - lastScrollY;
    lastScrollY = sy;

    let dPtrX = 0;
    let dPtrY = 0;
    let driftStepX = 0;

    if (!still && !isPaper) {
      // 1. Stage 2 Explosion Cascade:
      //    Starts slowly as blastFuel feeds blastPreCharge, then surges smoothly into radialVel
      if (blastFuel > 0.0005 || blastPreCharge > 0.0005 || radialVel > 0.002) {
        const transfer1 = blastFuel * 0.034 * dt;
        blastFuel -= transfer1;
        blastPreCharge += transfer1;

        const transfer2 = blastPreCharge * 0.044 * dt;
        blastPreCharge -= transfer2;
        radialVel += transfer2;

        // Silky exponential drag for a long, graceful deceleration
        radialVel *= Math.pow(0.974, dt);

        if (radialVel < 0.003 && blastFuel < 0.004 && blastPreCharge < 0.004) {
          radialVel = 0;
          blastFuel = 0;
          blastPreCharge = 0;
          clickCount = 0;
        }
      }

      // 2. Stage 1 Responsive Stationary Line Expansion
      const timeSinceClick = now - lastClickTime;
      if (timeSinceClick > 1050 && radialVel < 0.02 && blastFuel < 0.02) {
        lineTarget *= Math.pow(0.962, dt);
        if (lineTarget < 0.004) {
          lineTarget = 0;
          clickCount = 0;
        }
      }

      const effectiveLineTarget =
        radialVel > 0.02 || blastFuel > 0.02
          ? Math.min(1.75, lineTarget * 0.55 + radialVel * 0.062)
          : lineTarget;

      // Snappy yet critically damped spring so every click is felt immediately
      const springForce = (effectiveLineTarget - lineStretch) * 0.135 * dt;
      lineStretchVel = (lineStretchVel + springForce) * Math.pow(0.78, dt);
      lineStretch = Math.max(0, lineStretch + lineStretchVel * dt);

      if (radialVel > 0.3) {
        shockwaveRadius += radialVel * 1.45 * dt;
        shockwaveAlpha =
          Math.min(0.11, radialVel * 0.005) *
          Math.max(0, 1 - shockwaveRadius / (Math.hypot(w, h) * 0.72));
      } else {
        shockwaveAlpha *= Math.pow(0.88, dt);
      }

      // Scroll & pointer frame deltas
      vacuumVelY = vacuumVelY * Math.pow(0.91, dt) + scrollDelta * 0.24 + warpImpulseY;
      warpImpulseY *= Math.pow(0.86, dt);

      const driftFactor = Math.max(0, 1 - lineStretch * 1.4);
      driftStepX = 0.045 * driftFactor * dt;

      const prevCurX = curX;
      const prevCurY = curY;
      curX += (ptrX - curX) * 0.055 * dt;
      curY += (ptrY - curY) * 0.055 * dt;
      dPtrX = curX - prevCurX;
      dPtrY = curY - prevCurY;
    }

    ctx.clearRect(0, 0, w, h);

    if (isPaper) {
      drawPaperGraticule(sy);
    } else if (shockwaveAlpha > 0.003) {
      ctx.save();
      ctx.strokeStyle = "#f2efe9";
      ctx.globalAlpha = shockwaveAlpha;
      ctx.lineWidth = 1.15;
      ctx.beginPath();
      ctx.arc(w * 0.5, h * 0.5, shockwaveRadius, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }

    const absScrollVel = Math.abs(vacuumVelY);
    const cx = w * 0.5;
    const cy = h * 0.5;
    const maxCornerDist = Math.max(1, Math.hypot(cx, cy));
    const innerSoftZone = Math.min(w, h) * 0.15;

    for (let i = 0; i < stars.length; i++) {
      const s = stars[i];

      if (isPaper) {
        // PAPER MODE: Strictly scroll-driven, very low speck visibility
        const x = s.paperX;
        const oy = still ? 0 : -sy * (0.12 + s.z * 0.18);
        const y = (((s.paperY + oy) % h) + h) % h;

        ctx.globalAlpha = s.a * 0.14;
        ctx.fillStyle = s.inkColor;
        ctx.beginPath();
        ctx.arc(x, y, s.r * 0.62, 0, Math.PI * 2);
        ctx.fill();
        continue;
      }

      // VACUUM MODE: Pure continuous delta integration on (s.x, s.y)
      if (!still) {
        s.x += (dPtrX * 26 + driftStepX) * s.z;
        s.y += (dPtrY * 26 - vacuumVelY * 0.34 * dt) * s.z;
      }

      let dx = s.x - cx;
      let dy = s.y - cy;
      let dist = Math.hypot(dx, dy);
      if (dist < 1) {
        const randAngle = (i * 1.6180339) % (Math.PI * 2);
        dx = Math.cos(randAngle);
        dy = Math.sin(randAngle);
        dist = 1;
      }
      const ux = dx / dist;
      const uy = dy / dist;
      const normDist = Math.max(0.08, dist / maxCornerDist);

      // Stage 2: Continuous radial flight step
      if (radialVel > 0.002) {
        const radialStep = radialVel * s.z * (0.36 + normDist * 1.22) * dt;
        s.x += ux * radialStep;
        s.y += uy * radialStep;
      }

      if (s.fadeIn < 1) {
        s.fadeIn = Math.min(1, s.fadeIn + 0.032 * dt);
      }

      // Continuous boundary handling with area-uniform respawn (zero center bunching)
      const boundMargin = 200;
      if (
        s.x < -boundMargin ||
        s.x > w + boundMargin ||
        s.y < -boundMargin ||
        s.y > h + boundMargin
      ) {
        if (radialVel > 0.15) {
          const nextPos = sampleBalancedPosition(true);
          s.x = nextPos.x;
          s.y = nextPos.y;
          s.fadeIn = 0;
        } else {
          if (s.x < -boundMargin) s.x += w + boundMargin * 2;
          else if (s.x > w + boundMargin) s.x -= w + boundMargin * 2;
          if (s.y < -boundMargin) s.y += h + boundMargin * 2;
          else if (s.y > h + boundMargin) s.y -= h + boundMargin * 2;
        }
        dx = s.x - cx;
        dy = s.y - cy;
        dist = Math.max(1, Math.hypot(dx, dy));
      }

      // Soft attenuation near the exact center so the middle title/reading area is never cluttered
      const centerClearanceAlpha =
        dist < innerSoftZone ? 0.25 + 0.75 * (dist / innerSoftZone) : 1;

      // Unified continuous radial line length
      const radialLineLen = Math.min(
        210,
        (lineStretch * 88 + radialVel * 3.0) * s.z * (0.18 + normDist * 0.96),
      );

      const twinkle = still
        ? 1
        : 0.78 + 0.22 * Math.sin(now * 0.0014 * (s.speed * 100) + s.phase);
      const alpha =
        Math.min(1, s.a * twinkle + Math.min(0.26, lineStretch * 0.18)) *
        s.fadeIn *
        centerClearanceAlpha;

      ctx.fillStyle = s.color;
      ctx.strokeStyle = s.color;

      if (radialLineLen > 1.0) {
        const dirX = dx / dist;
        const dirY = dy / dist;
        const headX = s.x + dirX * radialLineLen;
        const headY = s.y + dirY * radialLineLen;

        // Draw a refined two-layer tapered light-line (soft full-length trail + bright leading core)
        ctx.lineCap = "round";
        ctx.globalAlpha = alpha * 0.42;
        ctx.lineWidth = s.r * (0.95 + Math.min(0.35, lineStretch * 0.2));
        ctx.beginPath();
        ctx.moveTo(s.x, s.y);
        ctx.lineTo(headX, headY);
        ctx.stroke();

        ctx.globalAlpha = alpha;
        ctx.lineWidth = s.r * (1.2 + Math.min(0.45, lineStretch * 0.25));
        ctx.beginPath();
        ctx.moveTo(s.x + dirX * (radialLineLen * 0.45), s.y + dirY * (radialLineLen * 0.45));
        ctx.lineTo(headX, headY);
        ctx.stroke();
      } else {
        ctx.globalAlpha = alpha;
        const scrollStreak = still ? 0 : Math.min(28, absScrollVel * s.z * 1.4);
        if (scrollStreak > 1.2) {
          ctx.lineWidth = s.r * 1.3;
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(s.x, s.y + (vacuumVelY >= 0 ? scrollStreak : -scrollStreak));
          ctx.stroke();
        } else {
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          ctx.fill();

          if (s.flare) {
            ctx.lineWidth = 0.55;
            ctx.globalAlpha = alpha * 0.42;
            const arm = s.r * 4.6;
            ctx.beginPath();
            ctx.moveTo(s.x - arm, s.y);
            ctx.lineTo(s.x + arm, s.y);
            ctx.moveTo(s.x, s.y - arm);
            ctx.lineTo(s.x, s.y + arm);
            ctx.stroke();
          }
        }
      }
    }

    if (!still) raf = requestAnimationFrame(draw);
  }

  export function triggerTimeTravelBoomerang() {
    if (still) return;
    if (document.documentElement.dataset.theme === "light") return;

    const now = performance.now();
    if (now - lastClickTime > 4500 && radialVel < 0.02 && blastFuel < 0.02) {
      clickCount = 0;
    }
    lastClickTime = now;
    clickCount += 1;

    // Clicks 1..4: Instant tactile spring kick + progressive stationary line expansion
    if (clickCount < EXPLOSION_THRESHOLD && radialVel < 0.05 && blastFuel < 0.05) {
      lineTarget = Math.min(1.4, (clickCount / (EXPLOSION_THRESHOLD - 1)) * 1.3);
      lineStretchVel += 0.055; // Immediate responsive impulse on click frame
      return;
    }

    // Click 5+: Smoothly feed energy into the continuous cascade reservoir
    lineTarget = 1.5;
    lineStretchVel += 0.04;
    if (radialVel < 0.3 && blastFuel < 1) {
      shockwaveRadius = 12;
    }
    blastFuel = Math.min(100, blastFuel + 40);
  }

  if (!still) {
    window.addEventListener(
      "pointermove",
      (e) => {
        ptrX = (e.clientX / Math.max(1, w) - 0.5) * 2;
        ptrY = (e.clientY / Math.max(1, h) - 0.5) * 2;
      },
      { passive: true },
    );

    window.addEventListener("still:warp", (e: Event) => {
      if (document.documentElement.dataset.theme === "light") return;
      const detail = (e as CustomEvent).detail;
      const dir = detail?.dir ?? 1;
      warpImpulseY = dir * 16;
    });

    window.addEventListener("still:timetravel", () => {
      triggerTimeTravelBoomerang();
    });
  }

  resize();
  draw();
  addEventListener(
    "resize",
    () => {
      resize();
      if (still) draw();
    },
    { passive: true },
  );
  document.addEventListener("visibilitychange", () => {
    if (still) return;
    if (document.hidden) {
      cancelAnimationFrame(raf);
    } else {
      lastFrameTime = 0;
      raf = requestAnimationFrame(draw);
    }
  });
</script>
