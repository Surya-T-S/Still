---
/**
 * TrajectoryNav — owned by Surya.
 * Ultra-minimal, whisper-quiet Top Navigation Bar.
 * Features a 1px reading progress filament, brand wordmark,
 * pure-black Chapters directory trigger, Prev/Next step controls,
 * and Vacuum/Paper mode toggle.
 */
---
<header class="minimal-nav" data-traj>
  <div class="scroll-progress-track" aria-hidden="true">
    <div class="scroll-progress-bar" data-scroll-progress></div>
  </div>

  <div class="nav-inner">
    <div class="nav-left">
      <button type="button" class="brand-btn" data-nav-home title="Return to Opening Cover">
        STILL
      </button>
      <span class="nav-sep" aria-hidden="true">·</span>
      <span class="status-where" data-hud-where>Origin</span>
    </div>

    <div class="nav-right">
      <button
        type="button"
        class="nav-pill chapters-trigger"
        data-open-chapters
        title="Open Chapters Index (Shortcut: C)"
      >
        <span data-chapters-btn-label>Chapters</span>
      </button>

      <div class="step-pair" role="group" aria-label="Chapter navigation">
        <button
          type="button"
          class="step-btn"
          data-traj-prev
          aria-label="Previous chapter"
          title="Previous chapter (←)"
        >
          ←
        </button>
        <span class="step-readout" data-traj-counter>00</span>
        <button
          type="button"
          class="step-btn"
          data-traj-next
          aria-label="Next chapter"
          title="Next chapter (→)"
        >
          →
        </button>
      </div>

      <button
        id="theme-toggle"
        type="button"
        class="nav-pill mode-pill"
        aria-label="Toggle Vacuum or Paper mode"
        title="Switch between Vacuum and Paper mode"
      >
        <span data-theme-label>Vacuum</span>
      </button>
    </div>
  </div>
</header>

<style>
  .minimal-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 56px;
    z-index: var(--z-nav);
    background: var(--c-bg-glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--c-line);
    display: flex;
    align-items: center;
    transition: background-color var(--d-base) var(--ease-out), border-color var(--d-base) var(--ease-out);
  }

  :global(body[data-view="chapters"]) .minimal-nav {
    background: rgba(0, 0, 0, 0.94);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    color: #f2efe9;
  }

  .scroll-progress-track {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1.5px;
    background: transparent;
    pointer-events: none;
  }

  .scroll-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--c-accent);
    transition: width 80ms linear;
  }

  .nav-inner {
    max-width: 1180px;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--s-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand-btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 4px 0;
    font: 700 0.82rem/1 var(--f-record);
    letter-spacing: 0.24em;
    color: var(--c-ink);
    cursor: pointer;
    transition: color var(--d-fast);
  }
  .brand-btn:hover {
    color: var(--c-accent);
  }

  .nav-sep {
    color: var(--c-ink-faint);
    font-size: 0.75rem;
    user-select: none;
  }

  .status-where {
    font: 400 0.72rem/1 var(--f-record);
    letter-spacing: 0.04em;
    color: var(--c-ink-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* Minimal Pill Buttons */
  .nav-pill {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 15px;
    border-radius: var(--r-pill);
    font: 400 0.68rem/1 var(--f-record);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-body);
    background: transparent;
    border: 1px solid var(--c-line-strong);
    cursor: pointer;
    transition:
      border-color var(--d-fast) var(--ease-out),
      background-color var(--d-fast) var(--ease-out),
      color var(--d-fast) var(--ease-out);
  }

  .nav-pill:hover,
  .nav-pill:focus-visible {
    color: var(--c-ink);
    border-color: var(--c-accent);
    background: rgba(242, 239, 233, 0.04);
  }

  .chapters-trigger.is-active {
    background: #f2efe9;
    color: #000000;
    border-color: #f2efe9;
  }

  /* Minimal Step Pair */
  .step-pair {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 4px;
    border-radius: var(--r-pill);
    border: 1px solid var(--c-line-strong);
    background: transparent;
  }

  .step-btn {
    appearance: none;
    background: none;
    border: 0;
    color: var(--c-ink-body);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font: 400 0.74rem/1 var(--f-record);
    cursor: pointer;
    transition: color var(--d-fast);
  }
  .step-btn:hover:not(:disabled) {
    color: var(--c-accent);
  }
  .step-btn:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .step-readout {
    font: 400 0.66rem/1 var(--f-record);
    letter-spacing: 0.08em;
    color: var(--c-ink-dim);
    padding-inline: 6px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 680px) {
    .nav-inner {
      padding-inline: var(--s-4);
    }
    .status-where,
    .nav-sep {
      display: none;
    }
  }
</style>

<script>
  import { scrollToChapter, stepChapter } from "../scripts/engine";

  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-chapter]"));
  const counterEl = document.querySelector<HTMLElement>("[data-traj-counter]");
  const scrollBarEl = document.querySelector<HTMLElement>("[data-scroll-progress]");
  const chaptersBtn = document.querySelector<HTMLButtonElement>("[data-open-chapters]");
  const chaptersBtnLabel = document.querySelector<HTMLElement>("[data-chapters-btn-label]");
  const homeBtn = document.querySelector<HTMLButtonElement>("[data-nav-home]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-traj-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-traj-next]");

  let lastStoryId = "prologue";
  let currentId = "prologue";

  const themeToggle = document.getElementById("theme-toggle");
  const themeLabel = document.querySelector<HTMLElement>("[data-theme-label]");
  const metaTheme = document.querySelector('meta[name="theme-color"]');

  function syncThemeUI(theme: string) {
    if (themeLabel) {
      themeLabel.textContent = theme === "light" ? "Paper" : "Vacuum";
    }
  }
  syncThemeUI(document.documentElement.dataset.theme || "dark");

  themeToggle?.addEventListener("click", () => {
    const current = document.documentElement.dataset.theme || "dark";
    const next = current === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("still-theme", next);
    } catch (_) {}
    if (metaTheme) {
      metaTheme.setAttribute("content", next === "light" ? "#f4f0e8" : "#07080a");
    }
    syncThemeUI(next);
  });

  function updateScrollProgress() {
    if (!scrollBarEl) return;
    const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    const pct = Math.min(100, Math.max(0, (window.scrollY / maxScroll) * 100));
    scrollBarEl.style.width = `${pct.toFixed(1)}%`;
  }
  window.addEventListener("scroll", updateScrollProgress, { passive: true });

  window.addEventListener("still:chapterchange", (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (!detail) return;
    const { index, id } = detail;
    currentId = id;

    if (id !== "chapters") {
      lastStoryId = id;
    }

    document.body.dataset.view = id === "chapters" ? "chapters" : "story";

    const isChaptersView = id === "chapters";
    chaptersBtn?.classList.toggle("is-active", isChaptersView);
    if (chaptersBtnLabel) {
      chaptersBtnLabel.textContent = isChaptersView ? "Resume" : "Chapters";
    }

    const missionChapters = chapters.filter(
      (c) => !["prologue", "chapters", "epilogue", "archive"].includes(c.id)
    );
    const missionIdx = missionChapters.findIndex((c) => c.id === id);

    if (counterEl) {
      if (id === "prologue") counterEl.textContent = "00";
      else if (id === "chapters") counterEl.textContent = "13";
      else if (id === "epilogue") counterEl.textContent = "END";
      else if (id === "archive") counterEl.textContent = "ARC";
      else if (missionIdx !== -1) {
        counterEl.textContent = `${String(missionIdx + 1).padStart(2, "0")}/13`;
      }
    }

    if (prevBtn) prevBtn.disabled = index <= 0;
    if (nextBtn) nextBtn.disabled = index >= chapters.length - 1;
    updateScrollProgress();
  });

  homeBtn?.addEventListener("click", () => scrollToChapter("prologue"));
  chaptersBtn?.addEventListener("click", () => {
    if (currentId === "chapters") {
      scrollToChapter(lastStoryId || "prologue");
    } else {
      scrollToChapter("chapters");
    }
  });

  prevBtn?.addEventListener("click", () => stepChapter(-1));
  nextBtn?.addEventListener("click", () => stepChapter(1));

  document.addEventListener("keydown", (e) => {
    const tag = (e.target as HTMLElement)?.tagName;
    if (tag === "INPUT" || tag === "TEXTAREA") return;
    if (e.key === "Escape" && currentId === "chapters") {
      scrollToChapter(lastStoryId || "prologue");
    } else if ((e.key === "c" || e.key === "C") && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      scrollToChapter(currentId === "chapters" ? lastStoryId : "chapters");
    } else if (e.key === "ArrowRight") {
      stepChapter(1);
    } else if (e.key === "ArrowLeft") {
      stepChapter(-1);
    }
  });
</script>
