---
/** VoiceBlock — owned by Surya. The imagined first-person layer; always clearly labelled. */
interface Props { lines: string[]; truthNote?: string }
const { lines, truthNote } = Astro.props;
---
<section class="voice" aria-label="Imagined voice">
  <span class="label">imagined voice</span>
  <blockquote data-split>
    {lines.map((l) => <p>{l}</p>)}
  </blockquote>
  {truthNote && <p class="truth" data-reveal><span>Myth check</span>{truthNote}</p>}
</section>

<style>
  .voice {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--s-12) var(--s-6) var(--s-16);
  }
  .label {
    display: inline-block;
    font: 500 0.68rem/1 var(--f-record);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    padding: 6px 12px;
  }
  blockquote {
    margin: var(--s-6) 0 0;
    padding-left: var(--s-6);
    border-left: 1px solid var(--c-line-strong);
  }
  blockquote p {
    font: italic 400 var(--t-lg)/var(--lh-voice) var(--f-voice);
    margin: 0 0 var(--s-4);
    color: var(--c-ink);
  }
  blockquote p:last-child { margin-bottom: 0; }
  .truth {
    font: 400 var(--t-sm)/var(--lh-body) var(--f-ui);
    color: var(--c-ink-dim);
    border-left: 2px solid var(--c-accent);
    padding-left: var(--s-4);
    margin-top: var(--s-8);
  }
  .truth span {
    display: block;
    font: 500 var(--t-xs)/1.6 var(--f-record);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--c-accent);
  }
</style>
