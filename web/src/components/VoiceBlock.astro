---
/**
 * VoiceBlock — owned by Surya.
 * Minimal, literary epigraph for the spacecraft's first-person voice.
 * Clean left hairline, generous leading, zero decorative clutter.
 */
interface Props {
  lines: string[];
  truthNote?: string;
}
const { lines, truthNote } = Astro.props;
---
<section class="voice-stage" aria-label="Imagined voice of the spacecraft">
  <blockquote class="transmissions" data-split>
    {lines.map((l) => (
      <p class="voice-line">{l}</p>
    ))}
  </blockquote>

  {truthNote && (
    <p class="truth-note" data-reveal>
      <span>Note — </span>{truthNote}
    </p>
  )}
</section>

<style>
  .voice-stage {
    max-width: var(--measure);
    margin: var(--s-12) auto var(--s-12);
    padding: 0 var(--s-6);
  }

  .transmissions {
    margin: 0;
    padding: var(--s-2) 0 var(--s-2) var(--s-6);
    border-left: 1px solid var(--c-accent);
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .voice-line {
    font: italic 400 var(--t-md)/var(--lh-voice) var(--f-voice);
    letter-spacing: 0.004em;
    word-spacing: 0.03em;
    margin: 0;
    color: var(--c-ink);
  }

  .voice-line:first-child::first-letter {
    color: var(--c-rubric);
    font-weight: 700;
    font-style: normal;
  }

  .truth-note {
    margin: var(--s-5) 0 0;
    padding-left: var(--s-6);
    font: 400 var(--t-xs)/1.75 var(--f-ui);
    letter-spacing: 0.005em;
    color: var(--c-ink-dim);
  }
  .truth-note span {
    color: var(--c-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 680px) {
    .voice-stage {
      padding: 0 var(--s-5);
    }
    .transmissions,
    .truth-note {
      padding-left: var(--s-4);
    }
  }
</style>
