---
/**
 * PingTheMoon — owned by Surya.
 * Interactive laser ranging moment for ALSEP / Apollo retroreflectors.
 */
interface Props {
  lightTimeSec?: number;
  recessionCmPerYear?: number;
}
const { lightTimeSec = 1.28, recessionCmPerYear = 3.8 } = Astro.props;
const roundTripSec = (lightTimeSec * 2).toFixed(2);
---
<div class="ping" data-reveal data-ping data-roundtrip={roundTripSec}>
  <div class="track" aria-hidden="true">
    <span class="end">Earth</span>
    <div class="beam-wrap">
      <div class="beam-line"></div>
      <div class="pulse" data-ping-pulse></div>
    </div>
    <span class="end">Moon</span>
  </div>

  <div class="controls">
    <button
      type="button"
      class="btn-orbital is-primary"
      data-nav-dir="next"
      data-target-act="moon"
      data-ping-btn
    >
      <span>Fire Laser Pulse</span>
      <svg class="btn-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <p class="readout" aria-live="polite" data-ping-readout>
      Round-trip light time: <strong>{roundTripSec} s</strong>
    </p>
  </div>

  <p class="reveal-note" hidden data-ping-note>
    Echo received in {roundTripSec} s. Because of Apollo’s passive fused-silica prisms, observatories can measure that the Moon drifts ~{recessionCmPerYear} cm farther from Earth every year.
  </p>
</div>

<style>
  .ping {
    max-width: var(--measure);
    margin: var(--s-8) auto var(--s-10);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-bg-raised);
    box-shadow: var(--sh-card);
    display: grid;
    gap: var(--s-5);
  }
  .track {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
  }
  .end {
    font: 700 0.66rem/1 var(--f-record);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
  }
  .beam-wrap {
    position: relative;
    height: 16px;
    display: flex;
    align-items: center;
  }
  .beam-line {
    width: 100%;
    height: 1px;
    background: var(--c-line-strong);
  }
  .pulse {
    position: absolute;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-accent);
    opacity: 0;
    transform: translateX(0);
    pointer-events: none;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }
  .readout {
    margin: 0;
    font: 400 var(--t-xs)/1.4 var(--f-record);
    color: var(--c-ink-dim);
    font-variant-numeric: tabular-nums;
  }
  .readout strong { color: var(--c-accent); font-weight: 700; }
  .reveal-note {
    margin: 0;
    font: 400 var(--t-sm)/var(--lh-body) var(--f-ui);
    color: var(--c-ink);
    border-top: 1px solid var(--c-line);
    padding-top: var(--s-4);
  }
  @media (max-width: 680px) {
    .ping {
      margin-inline: var(--s-4);
      padding: var(--s-5);
    }
  }
  @media (max-width: 480px) {
    .controls {
      flex-direction: column;
      align-items: stretch;
    }
    .controls .btn-orbital {
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-ping]").forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>("[data-ping-btn]");
    const pulse = root.querySelector<HTMLElement>("[data-ping-pulse]");
    const readout = root.querySelector<HTMLElement>("[data-ping-readout]");
    const note = root.querySelector<HTMLElement>("[data-ping-note]");
    const wrap = root.querySelector<HTMLElement>(".beam-wrap");
    if (!btn || !pulse || !readout || !note || !wrap) return;

    const roundTrip = Number(root.dataset.roundtrip || "2.56");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let busy = false;

    btn.addEventListener("click", () => {
      if (busy) return;
      busy = true;
      btn.disabled = true;
      note.hidden = true;

      if (reduced) {
        readout.innerHTML = `Echo returned: <strong>${roundTrip.toFixed(2)} s</strong>`;
        note.hidden = false;
        busy = false;
        btn.disabled = false;
        return;
      }

      const start = performance.now();
      const totalMs = roundTrip * 1000;
      const maxX = Math.max(0, wrap.clientWidth - 8);
      pulse.style.opacity = "1";

      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / totalMs);
        const elapsed = ((now - start) / 1000).toFixed(2);
        const x = p <= 0.5 ? (p * 2) * maxX : (1 - (p - 0.5) * 2) * maxX;
        pulse.style.transform = `translateX(${x}px)`;
        readout.innerHTML = p < 0.5
          ? `Outbound toward Moon… <strong>${elapsed} s</strong>`
          : `Reflected back toward Earth… <strong>${elapsed} s</strong>`;

        if (p < 1) {
          requestAnimationFrame(tick);
        } else {
          pulse.style.opacity = "0";
          readout.innerHTML = `Echo received: <strong>${roundTrip.toFixed(2)} s</strong>`;
          note.hidden = false;
          busy = false;
          btn.disabled = false;
        }
      };
      requestAnimationFrame(tick);
    });
  });
</script>
