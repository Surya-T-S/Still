---
/**
 * SendAMessage — owned by Surya.
 * Deep-space light-speed message moment for Pioneer 10 & 11.
 */
interface Props {
  lightTimeSec?: number;
  targetName?: string;
}
const { lightTimeSec = 66712, targetName = "Pioneer 10" } = Astro.props;
const hours = Math.floor(lightTimeSec / 3600);
const mins = Math.round((lightTimeSec % 3600) / 60);
---
<form class="send" data-reveal data-send data-light={lightTimeSec} data-target={targetName}>
  <label class="k" for="pioneer-msg">Transmit a radio signal toward {targetName}</label>
  <div class="row">
    <input
      id="pioneer-msg"
      type="text"
      maxlength="48"
      placeholder="Still listening from Earth."
      autocomplete="off"
      data-send-input
    />
    <button
      type="submit"
      class="btn-orbital is-primary"
      data-nav-dir="next"
      data-target-act="deep"
    >
      <span>Transmit</span>
      <svg class="btn-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
  <p class="status" aria-live="polite" data-send-status>
    One-way travel time at the speed of light: <strong>{hours} h {mins} min</strong>
  </p>
</form>

<style>
  .send {
    max-width: var(--measure);
    margin: var(--s-8) auto var(--s-10);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-bg-raised);
    box-shadow: var(--sh-card);
    display: grid;
    gap: var(--s-4);
  }
  .k {
    font: 700 0.66rem/1 var(--f-record);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
  }
  .row {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    align-items: center;
  }
  input {
    flex: 1 1 220px;
    background: var(--c-bg);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    padding: 12px 18px;
    color: var(--c-ink);
    font: 400 var(--t-sm)/1.4 var(--f-ui);
  }
  input::placeholder { color: var(--c-ink-faint); }
  .status {
    margin: 0;
    font: 400 var(--t-xs)/1.5 var(--f-record);
    color: var(--c-ink-dim);
    font-variant-numeric: tabular-nums;
  }
  .status strong { color: var(--c-accent); font-weight: 700; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-send]").forEach((form) => {
    const input = form.querySelector<HTMLInputElement>("[data-send-input]");
    const status = form.querySelector<HTMLElement>("[data-send-status]");
    if (!input || !status) return;

    const totalSec = Number(form.dataset.light || "66712");
    const target = form.dataset.target || "Pioneer 10";
    let timer = 0;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      clearInterval(timer);
      const msg = input.value.trim() || input.placeholder;
      const sentAt = Date.now();

      const update = () => {
        const elapsedSec = (Date.now() - sentAt) / 1000;
        const km = Math.round(elapsedSec * 299792.458).toLocaleString("en-US");
        const rem = Math.max(0, totalSec - elapsedSec);
        const rh = Math.floor(rem / 3600);
        const rm = Math.floor((rem % 3600) / 60);
        const rs = Math.floor(rem % 60);
        status.innerHTML = `“${msg}” — <strong>${km} km</strong> from Earth · reaches ${target} in <strong>${rh}h ${rm}m ${rs}s</strong>`;
      };
      update();
      timer = window.setInterval(update, 250);
    });
  });
</script>
