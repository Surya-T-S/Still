---
/**
 * SolOdometer — owned by Surya.
 * Visualizes Opportunity's 90-sol warranty vs 5,352 sols of actual exploration.
 */
interface Props {
  planned?: number;
  actual?: number;
  unit?: string;
}
const { planned = 90, actual = 5352, unit = "sols" } = Astro.props;
const ratio = Math.round(actual / planned);
const plannedPct = Math.max(1.5, (planned / actual) * 100).toFixed(2);
---
<div class="odo" data-reveal data-odo data-planned={planned} data-actual={actual}>
  <div class="nums">
    <div>
      <span class="k">Planned Mission</span>
      <span class="v dim">{planned} {unit}</span>
    </div>
    <div class="right">
      <span class="k">Actual Endurance</span>
      <span class="v accent"><span data-odo-count>{actual.toLocaleString("en-US")}</span> {unit}</span>
    </div>
  </div>

  <div class="bar-track" aria-hidden="true">
    <div class="bar-fill" data-odo-bar></div>
    <div class="bar-planned" style={`left: ${plannedPct}%`} title={`Planned: ${planned} ${unit}`}></div>
  </div>

  <p class="note">
    Outlived its original {planned}-sol design life by <strong>{ratio}×</strong> before the global dust storm of 2018.
  </p>
</div>

<style>
  .odo {
    max-width: var(--measure);
    margin: var(--s-8) auto var(--s-10);
    padding: var(--s-6);
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    background: var(--c-bg-raised);
    display: grid;
    gap: var(--s-4);
  }
  .nums {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s-4);
  }
  .right { text-align: right; }
  .k {
    display: block;
    font: 400 0.68rem/1 var(--f-record);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
    margin-bottom: var(--s-2);
  }
  .v {
    font: 400 var(--t-lg)/1 var(--f-voice);
    font-variant-numeric: tabular-nums;
  }
  .dim { color: var(--c-ink-dim); }
  .accent { color: var(--c-accent); }
  .bar-track {
    position: relative;
    height: 4px;
    background: var(--c-line-strong);
    overflow: hidden;
  }
  .bar-fill {
    position: absolute;
    inset: 0;
    background: var(--c-accent);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 1.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bar-fill.is-active {
    transform: scaleX(1);
  }
  .bar-planned {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--c-ink);
  }
  .note {
    margin: 0;
    font: 400 var(--t-sm)/1.5 var(--f-ui);
    color: var(--c-ink-dim);
  }
  .note strong { color: var(--c-ink); font-weight: 500; }
</style>

<script>
  import { gsap } from "gsap";
  import { reduced } from "../motion/index";

  document.querySelectorAll<HTMLElement>("[data-odo]").forEach((root) => {
    const countEl = root.querySelector<HTMLElement>("[data-odo-count]");
    const barEl = root.querySelector<HTMLElement>("[data-odo-bar]");
    if (!countEl || !barEl) return;

    const actual = Number(root.dataset.actual || "5352");
    if (reduced()) {
      countEl.textContent = actual.toLocaleString("en-US");
      barEl.classList.add("is-active");
      return;
    }

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          barEl.classList.add("is-active");
          const state = { v: 0 };
          gsap.to(state, {
            v: actual,
            duration: 1.8,
            ease: "power2.out",
            onUpdate: () => {
              countEl.textContent = Math.round(state.v).toLocaleString("en-US");
            },
          });
          io.disconnect();
        }
      }
    }, { threshold: 0.2 });

    io.observe(root);
  });
</script>
