---
import "../tokens/tokens.css";
import "../styles/global.css";
import SignalHUD from "../components/SignalHUD.astro";
import Starfield from "../components/Starfield.astro";
import TrajectoryNav from "../components/TrajectoryNav.astro";

interface Props { title?: string; description?: string }
const {
  title = "STILL · Abandoned, Not Forgotten",
  description = "An interactive archival exhibition of the spacecraft humanity left on the Moon, Mars, and in deep space.",
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem("still-theme");
          const theme = stored === "light" || stored === "dark" ? stored : "dark";
          document.documentElement.dataset.theme = theme;
          const metaTheme = document.querySelector('meta[name="theme-color"]');
          if (metaTheme) {
            metaTheme.setAttribute("content", theme === "light" ? "#f3efe6" : "#07080a");
          }
        } catch (_) {}
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("js-motion");
        }
      })();
    </script>
  </head>
  <body data-act="moon">
    <a class="skip" href="#archive">Skip to the archival registry</a>
    <Starfield />
    <TrajectoryNav />
    <SignalHUD />

    <main><slot /></main>

    <a
      class="github-corner-mark"
      href="https://github.com/Surya-T-S/Still"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="View STILL source repository on GitHub"
      title="GitHub Repository"
    >
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
        <path d="M12 0.297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385 0.6 0.113 0.82-0.258 0.82-0.577 0-0.285-0.01-1.04-0.015-2.04-3.338 0.724-4.042-1.61-4.042-1.61-0.546-1.385-1.335-1.755-1.335-1.755-1.087-0.744 0.084-0.729 0.084-0.729 1.205 0.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495 0.998 0.108-0.776 0.417-1.305 0.76-1.605-2.665-0.3-5.466-1.332-5.466-5.93 0-1.31 0.465-2.38 1.235-3.22-0.135-0.303-0.54-1.523 0.105-3.176 0 0 1.005-0.322 3.3 1.23 0.96-0.267 1.98-0.399 3-0.405 1.02 0.006 2.04 0.138 3 0.405 2.28-1.552 3.285-1.23 3.285-1.23 0.645 1.653 0.24 2.873 0.12 3.176 0.765 0.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92 0.42 0.36 0.81 1.096 0.81 2.22 0 1.606-0.015 2.896-0.015 3.286 0 0.315 0.21 0.69 0.825 0.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12z" />
      </svg>
    </a>

    <script>
      import "../scripts/engine.ts";
    </script>
  </body>
</html>

<style>
  .github-corner-mark {
    position: fixed;
    right: clamp(14px, 2vw, 24px);
    bottom: clamp(12px, 1.8vw, 20px);
    z-index: var(--z-nav);
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--c-ink-dim);
    opacity: 0.38;
    text-decoration: none;
    transition:
      opacity var(--d-fast) var(--ease-out),
      color var(--d-fast) var(--ease-out),
      transform var(--d-fast) var(--ease-spring);
  }

  .github-corner-mark:hover,
  .github-corner-mark:focus-visible {
    color: var(--c-ink);
    opacity: 0.92;
    transform: translateY(-1px);
  }
</style>
