---
/**
 * index.astro — Primary Exhibition Deck for STILL.
 * Structured as a focused, chapter-by-chapter reading experience:
 * Cover (Prologue) → 13 Mission Chapters (Moon, Mars, Deep Space) → Epilogue → Archival Registry.
 * Features navigation-dependent aerospace capsule controls that adapt to target sector & direction.
 */
import Base from "../layouts/Base.astro";
import { getCollection, getEntry, render } from "astro:content";
import ChapterHero from "../components/ChapterHero.astro";
import VoiceBlock from "../components/VoiceBlock.astro";
import RecordCard from "../components/RecordCard.astro";
import CitationChip from "../components/CitationChip.astro";
import ThenNowSlider from "../interactions/ThenNowSlider.astro";
import PingTheMoon from "../interactions/PingTheMoon.astro";
import SolOdometer from "../interactions/SolOdometer.astro";
import FlightCounter from "../interactions/FlightCounter.astro";
import SendAMessage from "../interactions/SendAMessage.astro";

const ACT_ORDER = { moon: 0, mars: 1, deep: 2 } as const;
const ACT_LABEL = { moon: "The Moon", mars: "Mars", deep: "Deep Space" } as const;
const ACT_ROMAN = { moon: "Act I · The Moon", mars: "Act II · Mars", deep: "Act III · Deep Space" } as const;

// Fetch and sort artifacts: Moon → Mars → Deep Space
const rawArtifacts = await getCollection("artifacts");
const artifacts = rawArtifacts
  .map((e) => e.data)
  .sort((a, b) => ACT_ORDER[a.act] - ACT_ORDER[b.act] || a.order - b.order);

// Fact verification gate: `npm run build:strict` enforces verified facts
if (process.env.STRICT_FACTS === "true") {
  const unverified = artifacts.filter((a) => !a.verified).map((a) => a.slug);
  if (unverified.length > 0) {
    throw new Error(`Unverified artifacts detected (Data review required): ${unverified.join(", ")}`);
  }
}

// Pair artifacts with story MDX chapters
const chapters = await Promise.all(
  artifacts.map(async (a) => {
    const story = await getEntry("story", a.slug);
    const Body = story ? (await render(story)).Content : null;
    return { a, story: story?.data, Body };
  }),
);

// Fetch Prologue and Epilogue stories
const prologueEntry = await getEntry("story", "prologue");
const PrologueBody = prologueEntry ? (await render(prologueEntry)).Content : null;
const prologue = prologueEntry?.data;

const epilogueEntry = await getEntry("story", "epilogue");
const EpilogueBody = epilogueEntry ? (await render(epilogueEntry)).Content : null;
const epilogue = epilogueEntry?.data;

// Group chapters by Act for the Cover Directory
const moonChapters = chapters.filter((c) => c.a.act === "moon");
const marsChapters = chapters.filter((c) => c.a.act === "mars");
const deepChapters = chapters.filter((c) => c.a.act === "deep");

// Helper to sanitize image paths for public asset serving
function resolveImgSrc(pathStr?: string): string {
  if (!pathStr) return "";
  if (pathStr.startsWith("/")) return pathStr;
  return pathStr.replace("../data/images/", "/images/").replace("../data/", "/");
}

function fmtLightShort(sec: number): string {
  if (sec < 60) return `${sec.toFixed(2)}s`;
  if (sec < 3600) return `${Math.floor(sec / 60)}m`;
  return `${(sec / 3600).toFixed(1)}h`;
}
---
<Base>
  <!-- COVER / PROLOGUE -->
  {prologue && (
    <section
      class="chapter prologue is-active"
      id="prologue"
      data-chapter
      data-label="Earth · Origin"
      data-act="moon"
      data-distance="0"
      data-light="0"
    >
      <div class="prologue-inner">
        <div class="cover-eyebrow" data-reveal>
          <span>Exhibition &amp; Historical Archive</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>13 Silent Spacecraft</span>
        </div>

        <div class="cover-title-lockup" data-reveal>
          <h1 class="cover-title">STILL</h1>
          <p class="cover-subtitle">
            Abandoned, Not Forgotten — Humanity’s Silent Fleet on the Moon, Mars, and in Deep Space
          </p>
        </div>

        <!-- Micro-SVG Solar System Signal Scale -->
        <div class="scale-filament" data-reveal aria-hidden="true">
          <svg class="scale-svg" viewBox="0 0 760 44" fill="none">
            <line x1="24" y1="22" x2="736" y2="22" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" />
            <!-- Earth -->
            <circle cx="24" cy="22" r="3.5" fill="var(--c-bg)" stroke="currentColor" stroke-width="1.2" />
            <text x="24" y="39" fill="currentColor" opacity="0.65" font-size="9" font-family="var(--f-record)" letter-spacing="1.2">EARTH (0s)</text>
            <!-- Moon -->
            <circle cx="190" cy="22" r="3.5" fill="var(--c-moon)" />
            <text x="190" y="39" fill="currentColor" opacity="0.75" font-size="9" font-family="var(--f-record)" text-anchor="middle" letter-spacing="1.2">THE MOON (1.28s)</text>
            <!-- Mars -->
            <circle cx="430" cy="22" r="3.5" fill="var(--c-mars)" />
            <text x="430" y="39" fill="currentColor" opacity="0.75" font-size="9" font-family="var(--f-record)" text-anchor="middle" letter-spacing="1.2">MARS (12.5m)</text>
            <!-- Deep Space -->
            <circle cx="736" cy="22" r="3.5" fill="var(--c-deep)" />
            <text x="736" y="39" fill="currentColor" opacity="0.75" font-size="9" font-family="var(--f-record)" text-anchor="end" letter-spacing="1.2">DEEP SPACE (18.5h)</text>
            <!-- Traveling signal photon -->
            <circle class="scale-photon" cx="24" cy="22" r="2.5" fill="var(--c-ink)" />
          </svg>
        </div>

        <!-- Poetic Opening Voice -->
        <blockquote class="prologue-voice" data-split>
          {prologue.voice.map((line) => (
            <p>{line}</p>
          ))}
        </blockquote>

        <!-- Prologue Narrative Body -->
        {PrologueBody && (
          <div class="prologue-prose" data-reveal>
            <PrologueBody />
          </div>
        )}

        <!-- Navigation-Aware Primary & Secondary Capsule Controls -->
        <div class="prologue-actions" data-reveal>
          <button
            type="button"
            class="btn-orbital is-primary"
            data-nav-dir="next"
            data-target-act="moon"
            data-scroll-target="apollo-lunar-modules"
          >
            <span>{prologue.legacyLine}</span>
            <span class="btn-badge">1.28s DELAY</span>
            <svg class="btn-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <button
            type="button"
            class="btn-orbital"
            data-nav-dir="next"
            data-target-act="deep"
            data-scroll-target="archive"
          >
            <span>Archival Registry</span>
            <span class="btn-badge">13 RECORDS</span>
          </button>
        </div>

        <!-- Clean 3-Column Interactive Chapter Directory -->
        <div class="cover-directory" data-reveal aria-label="Chapter directory by sector">
          <div class="dir-col" data-target-act="moon">
            <div class="dir-head">
              <span class="dir-act">Act I · The Moon</span>
              <span class="dir-delay">1.28 s</span>
            </div>
            <ol class="dir-list">
              {moonChapters.map(({ a }, i) => (
                <li>
                  <button
                    type="button"
                    class="dir-capsule"
                    data-target-act="moon"
                    data-scroll-target={a.slug}
                  >
                    <span class="dir-num">{String(i + 1).padStart(2, "0")}</span>
                    <span class="dir-name">{a.nickname ?? a.name}</span>
                    <span class="dir-arrow" aria-hidden="true">→</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>

          <div class="dir-col" data-target-act="mars">
            <div class="dir-head">
              <span class="dir-act">Act II · Mars</span>
              <span class="dir-delay">12.5 min</span>
            </div>
            <ol class="dir-list" start="5">
              {marsChapters.map(({ a }, i) => (
                <li>
                  <button
                    type="button"
                    class="dir-capsule"
                    data-target-act="mars"
                    data-scroll-target={a.slug}
                  >
                    <span class="dir-num">{String(i + 5).padStart(2, "0")}</span>
                    <span class="dir-name">{a.nickname ?? a.name}</span>
                    <span class="dir-arrow" aria-hidden="true">→</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>

          <div class="dir-col" data-target-act="deep">
            <div class="dir-head">
              <span class="dir-act">Act III · Deep Space</span>
              <span class="dir-delay">Hours</span>
            </div>
            <ol class="dir-list" start="10">
              {deepChapters.map(({ a }, i) => (
                <li>
                  <button
                    type="button"
                    class="dir-capsule"
                    data-target-act="deep"
                    data-scroll-target={a.slug}
                  >
                    <span class="dir-num">{String(i + 10).padStart(2, "0")}</span>
                    <span class="dir-name">{a.nickname ?? a.name}</span>
                    <span class="dir-arrow" aria-hidden="true">→</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 13 MISSION CHAPTERS -->
  {chapters.map(({ a, story, Body }, idx) => {
    const hasBothImages = Boolean(a.images.then && a.images.now);
    const prevChapter = idx > 0 ? chapters[idx - 1].a : null;
    const nextChapter = idx < chapters.length - 1 ? chapters[idx + 1].a : null;
    const isNextNewAct = nextChapter && nextChapter.act !== a.act;

    return (
      <section
        class="chapter"
        id={a.slug}
        data-chapter
        data-label={`${ACT_LABEL[a.act]} · ${a.nickname ?? a.name}`}
        data-act={a.act}
        data-distance={a.distanceKm}
        data-light={a.lightTimeSec}
      >
        <ChapterHero
          name={a.name}
          nickname={a.nickname}
          hook={story?.hook ?? ""}
          act={a.act}
          index={idx + 1}
          total={chapters.length}
          mission={a.mission}
          site={a.location.site}
          distanceKm={a.distanceKm}
          lightTimeSec={a.lightTimeSec}
        />

        {story && (
          <VoiceBlock
            lines={story.voice}
            truthNote={story.truthNote}
          />
        )}

        {Body && (
          <div class="narration" data-reveal>
            <Body />
          </div>
        )}

        {/* Signature Interactive Moments */}
        {a.slug === "alsep" && (
          <PingTheMoon lightTimeSec={a.lightTimeSec} />
        )}

        {a.slug === "spirit-opportunity" && (
          <SolOdometer
            planned={a.planned?.value}
            actual={a.actual?.value}
            unit={a.planned?.unit}
          />
        )}

        {a.slug === "ingenuity" && (
          <FlightCounter
            planned={a.planned?.value}
            actual={a.actual?.value}
          />
        )}

        {a.slug === "pioneer" && (
          <SendAMessage
            lightTimeSec={a.lightTimeSec}
            targetName={a.name}
          />
        )}

        {/* NASA Archival Photography (Then vs Now Slider or Single Plate) */}
        {hasBothImages ? (
          <ThenNowSlider
            thenImg={{ ...a.images.then!, src: resolveImgSrc(a.images.then!.src) }}
            nowImg={{ ...a.images.now!, src: resolveImgSrc(a.images.now!.src) }}
            title={a.nickname ?? a.name}
          />
        ) : a.images.then ? (
          <div class="chapter-imagery" data-reveal>
            <figure class="single-image-card">
              <div class="image-wrapper">
                <img
                  src={resolveImgSrc(a.images.then.src)}
                  alt={a.images.then.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="image-caption">
                <p class="caption-text">{a.images.then.alt}</p>
                <span class="caption-credit">Photograph: {a.images.then.credit}</span>
              </figcaption>
            </figure>
          </div>
        ) : null}

        <RecordCard
          stats={a.stats}
          lastContact={a.lastContact}
          site={a.location.site}
          nssdcaId={a.nssdcaId}
          nssdcaUrl={a.nssdcaUrl}
          legacy={a.legacy}
        />

        <!-- Navigation-Dependent Chapter Pagination Pods -->
        <nav class="chapter-pager" aria-label="Chapter pagination">
          {prevChapter ? (
            <button
              type="button"
              class="pager-capsule prev"
              data-nav-dir="prev"
              data-target-act={prevChapter.act}
              data-scroll-target={prevChapter.slug}
            >
              <div class="pager-top">
                <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M13 8H3M3 8L7.5 3.5M3 8L7.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pager-dir">Chapter {String(idx).padStart(2, "0")} · {ACT_LABEL[prevChapter.act]}</span>
                <span class="pager-pill">{fmtLightShort(prevChapter.lightTimeSec)}</span>
              </div>
              <span class="pager-name">{prevChapter.nickname ?? prevChapter.name}</span>
            </button>
          ) : (
            <button
              type="button"
              class="pager-capsule prev"
              data-nav-dir="prev"
              data-target-act="moon"
              data-scroll-target="prologue"
            >
              <div class="pager-top">
                <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M13 8H3M3 8L7.5 3.5M3 8L7.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pager-dir">Return to Origin</span>
                <span class="pager-pill">0.00s</span>
              </div>
              <span class="pager-name">Opening Cover · Earth</span>
            </button>
          )}

          {nextChapter ? (
            <button
              type="button"
              class={`pager-capsule next ${isNextNewAct ? "is-sector-jump" : ""}`}
              data-nav-dir="next"
              data-target-act={nextChapter.act}
              data-scroll-target={nextChapter.slug}
            >
              <div class="pager-top">
                <span class="pager-pill">{fmtLightShort(nextChapter.lightTimeSec)}</span>
                <span class="pager-dir">
                  {isNextNewAct
                    ? `Enter ${ACT_ROMAN[nextChapter.act]}`
                    : `Chapter ${String(idx + 2).padStart(2, "0")} · ${ACT_LABEL[nextChapter.act]}`}
                </span>
                <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <span class="pager-name">{nextChapter.nickname ?? nextChapter.name}</span>
            </button>
          ) : (
            <button
              type="button"
              class="pager-capsule next is-sector-jump"
              data-nav-dir="next"
              data-target-act="deep"
              data-scroll-target="epilogue"
            >
              <div class="pager-top">
                <span class="pager-pill">22.2h</span>
                <span class="pager-dir">Closing Reflection</span>
                <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <span class="pager-name">Epilogue · What Remains</span>
            </button>
          )}
        </nav>
      </section>
    );
  })}

  <!-- EPILOGUE -->
  {epilogue && (
    <section
      class="chapter epilogue"
      id="epilogue"
      data-chapter
      data-label="Epilogue · The Silent Fleet"
      data-act="deep"
      data-distance="24000000000"
      data-light="80000"
    >
      <div class="epilogue-container">
        <header class="epilogue-header" data-reveal>
          <span class="epilogue-kicker">Epilogue · Across the Solar System</span>
          <h1 class="epilogue-title">{epilogue.hook}</h1>
        </header>

        <blockquote class="epilogue-voice" data-split>
          {epilogue.voice.map((line) => (
            <p class="epilogue-line">{line}</p>
          ))}
        </blockquote>

        {EpilogueBody && (
          <div class="narration epilogue-prose" data-reveal>
            <EpilogueBody />
          </div>
        )}

        {epilogue.keepsake && (
          <aside class="keepsake-card" data-reveal>
            <span class="keepsake-title">Reflection &amp; Light-Time Simulator</span>
            <p class="keepsake-body">{epilogue.keepsake}</p>

            <div class="simulator-box" id="echo-sim">
              <span class="sim-label">Select a spacecraft to compare round-trip light delay from Earth:</span>
              <div class="sim-targets" role="group" aria-label="Select target spacecraft">
                {artifacts.filter((x) => ["apollo-lunar-modules", "spirit-opportunity", "dawn", "pioneer"].includes(x.slug)).map((x, i) => (
                  <button
                    type="button"
                    class={`sim-btn ${i === 0 ? "active" : ""}`}
                    data-target-act={x.act}
                    data-dist={x.distanceKm}
                    data-light={x.lightTimeSec}
                    data-name={x.nickname ?? x.name}
                  >
                    {x.nickname ?? x.name}
                  </button>
                ))}
              </div>
              <div class="sim-readout">
                <span class="sim-where" data-sim-target>Eagle (Apollo 11)</span>
                <span class="sim-dist" data-sim-dist>384,400 km</span>
                <span class="sim-time" data-sim-delay>2.56 s round-trip light delay</span>
              </div>
            </div>
          </aside>
        )}

        <div class="epilogue-legacy-box" data-reveal>
          <p class="legacy-final-line">“{epilogue.legacyLine}”</p>
        </div>

        <nav class="chapter-pager" aria-label="Chapter pagination">
          <button
            type="button"
            class="pager-capsule prev"
            data-nav-dir="prev"
            data-target-act="deep"
            data-scroll-target="kepler"
          >
            <div class="pager-top">
              <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M13 8H3M3 8L7.5 3.5M3 8L7.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="pager-dir">Chapter 13 · Deep Space</span>
            </div>
            <span class="pager-name">Kepler Space Telescope</span>
          </button>

          <button
            type="button"
            class="pager-capsule next"
            data-nav-dir="next"
            data-target-act="deep"
            data-scroll-target="archive"
          >
            <div class="pager-top">
              <span class="pager-dir">Master Registry</span>
              <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <span class="pager-name">The Silent Fleet Archive</span>
          </button>
        </nav>
      </div>
    </section>
  )}

  <!-- ARCHIVE: Master Historical Index -->
  <section
    id="archive"
    class="chapter archive"
    data-chapter
    data-label="Archive · Master Registry"
    data-act="deep"
    data-distance="0"
    data-light="0"
  >
    <div class="archive-inner">
      <div class="archive-header" data-reveal>
        <span class="archive-kicker">Master Historical Index</span>
        <h1>The Silent Fleet Archive</h1>
        <p class="archive-sub">
          Complete verifiable registry of the 13 missions featured in STILL. Select any spacecraft to open its chapter.
        </p>

        <div class="archive-filters" role="group" aria-label="Filter artifacts by sector">
          <button type="button" class="filter-btn active" data-filter="all">All (13)</button>
          <button type="button" class="filter-btn" data-target-act="moon" data-filter="moon">The Moon (4)</button>
          <button type="button" class="filter-btn" data-target-act="mars" data-filter="mars">Mars (5)</button>
          <button type="button" class="filter-btn" data-target-act="deep" data-filter="deep">Deep Space (4)</button>
        </div>
      </div>

      <div class="archive-table-wrapper" data-reveal>
        <table class="archive-table" id="archive-table">
          <thead>
            <tr>
              <th>Spacecraft</th>
              <th>Body</th>
              <th>Mission</th>
              <th>Last Contact</th>
              <th>Light Delay</th>
              <th>NSSDCA Record</th>
            </tr>
          </thead>
          <tbody>
            {artifacts.map((a) => (
              <tr data-act={a.act} data-slug={a.slug} class="archive-row">
                <td class="name-col">
                  <a href={`#${a.slug}`} class="archive-link" data-scroll-slug={a.slug}>{a.nickname ?? a.name}</a>
                </td>
                <td><span class={`body-tag tag-${a.act}`}>{a.location.body}</span></td>
                <td class="mission-col">{a.mission}</td>
                <td class="contact-col">{a.lastContact}</td>
                <td class="delay-col">{a.lightTimeSec < 60 ? `${a.lightTimeSec}s` : `${Math.floor(a.lightTimeSec / 60)}m`}</td>
                <td class="chip-col">
                  <CitationChip href={a.nssdcaUrl} label={`NSSDCA ${a.nssdcaId}`} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <nav class="chapter-pager" aria-label="Chapter pagination">
        <button
          type="button"
          class="pager-capsule prev"
          data-nav-dir="prev"
          data-target-act="deep"
          data-scroll-target="epilogue"
        >
          <div class="pager-top">
            <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13 8H3M3 8L7.5 3.5M3 8L7.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="pager-dir">Previous</span>
          </div>
          <span class="pager-name">Epilogue · What Remains</span>
        </button>

        <button
          type="button"
          class="pager-capsule next"
          data-nav-dir="next"
          data-target-act="moon"
          data-scroll-target="prologue"
        >
          <div class="pager-top">
            <span class="pager-dir">Return to Start</span>
            <svg class="pager-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="pager-name">Opening Cover · STILL</span>
        </button>
      </nav>

      <footer class="archive-footer">
        <p class="credit">
          Imagery, coordinates, and historical records courtesy of NASA / JPL-Caltech / Arizona State University / Goddard Space Flight Center (NSSDCA). Created for the 2026 NASA Space Apps Challenge.
        </p>
      </footer>
    </div>
  </section>
</Base>

<script>
  import { scrollToChapter } from "../scripts/engine";

  // 1. All chapter navigation buttons ([data-scroll-target]) + cursor-tracked specular radial highlight
  document.querySelectorAll<HTMLElement>("[data-scroll-target], .btn-orbital, .pager-capsule").forEach((btn) => {
    btn.addEventListener("pointermove", (e) => {
      const rect = btn.getBoundingClientRect();
      const xPct = ((e.clientX - rect.left) / Math.max(1, rect.width)) * 100;
      btn.style.setProperty("--btn-origin-x", `${xPct.toFixed(1)}%`);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-scroll-target]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.scrollTarget;
      if (target) scrollToChapter(target);
    });
  });

  // 2. Interactive Archive Filtering & Row Jumps
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const tableRows = document.querySelectorAll<HTMLElement>(".archive-row");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const act = btn.dataset.filter;
      tableRows.forEach((row) => {
        if (act === "all" || row.dataset.act === act) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-scroll-slug]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const slug = link.dataset.scrollSlug;
      if (slug) scrollToChapter(slug);
    });
  });

  // 3. Epilogue Radio Simulator
  const simBtns = document.querySelectorAll<HTMLButtonElement>(".sim-btn");
  const simTarget = document.querySelector<HTMLElement>("[data-sim-target]");
  const simDist = document.querySelector<HTMLElement>("[data-sim-dist]");
  const simDelay = document.querySelector<HTMLElement>("[data-sim-delay]");

  const fmtDist = (km: number) =>
    km >= 1e9 ? `${(km / 1e9).toFixed(2)} billion km`
    : km >= 1e6 ? `${(km / 1e6).toFixed(1)} million km`
    : `${Math.round(km).toLocaleString("en-US")} km`;

  const fmtDelay = (sec: number) => {
    const roundTrip = sec * 2;
    if (roundTrip < 60) return `${roundTrip.toFixed(2)} s round-trip light delay`;
    if (roundTrip < 3600) return `${Math.floor(roundTrip / 60)}m ${Math.round(roundTrip % 60)}s round-trip delay`;
    return `${Math.floor(roundTrip / 3600)}h ${Math.round((roundTrip % 3600) / 60)}m round-trip delay`;
  };

  simBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      simBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const name = btn.dataset.name ?? "";
      const dist = Number(btn.dataset.dist ?? 0);
      const light = Number(btn.dataset.light ?? 0);

      if (simTarget) simTarget.textContent = name;
      if (simDist) simDist.textContent = fmtDist(dist);
      if (simDelay) simDelay.textContent = fmtDelay(light);
    });
  });
</script>

