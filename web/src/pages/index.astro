---
/**
 * index.astro — Primary Storytelling Deck for STILL.
 * Designed around uncluttered literary minimalism and scientific Space Mono typography:
 * 1. Opening Cover (#prologue)
 * 2. Pure-Black (#000000) Uncluttered Chapters Index (#chapters)
 * 3. 13 Long-Form Mission Stories with generous breathing space
 * 4. Epilogue (#epilogue) & Archival Registry (#archive)
 */
import Base from "../layouts/Base.astro";
import { getCollection, getEntry, render } from "astro:content";
import ChapterHero from "../components/ChapterHero.astro";
import VoiceBlock from "../components/VoiceBlock.astro";
import RecordCard from "../components/RecordCard.astro";
import CitationChip from "../components/CitationChip.astro";
import ThenNowSlider from "../interactions/ThenNowSlider.astro";
import PingTheMoon from "../interactions/PingTheMoon.astro";
import SolOdometer from "../interactions/SolOdometer.astro";
import FlightCounter from "../interactions/FlightCounter.astro";
import SendAMessage from "../interactions/SendAMessage.astro";

const ACT_ORDER = { moon: 0, mars: 1, deep: 2 } as const;
const ACT_LABEL = { moon: "The Moon", mars: "Mars", deep: "Deep Space" } as const;

const ACT_META = [
  {
    key: "moon" as const,
    title: "I · The Moon",
    delay: "1.28 s light delay",
  },
  {
    key: "mars" as const,
    title: "II · Mars",
    delay: "12.5 min light delay",
  },
  {
    key: "deep" as const,
    title: "III · Deep Space",
    delay: "Hours across the dark",
  },
];

// Fetch and sort artifacts: Moon → Mars → Deep Space
const rawArtifacts = await getCollection("artifacts");
const artifacts = rawArtifacts
  .map((e) => e.data)
  .sort((a, b) => ACT_ORDER[a.act] - ACT_ORDER[b.act] || a.order - b.order);

// Fact verification gate: `npm run build:strict` enforces verified facts
if (process.env.STRICT_FACTS === "true") {
  const unverified = artifacts.filter((a) => !a.verified).map((a) => a.slug);
  if (unverified.length > 0) {
    throw new Error(`Unverified artifacts detected (Data review required): ${unverified.join(", ")}`);
  }
}

// Pair artifacts with story MDX chapters
const chapters = await Promise.all(
  artifacts.map(async (a) => {
    const story = await getEntry("story", a.slug);
    const Body = story ? (await render(story)).Content : null;
    return { a, story: story?.data, Body };
  }),
);

// Fetch Prologue and Epilogue stories
const prologueEntry = await getEntry("story", "prologue");
const PrologueBody = prologueEntry ? (await render(prologueEntry)).Content : null;
const prologue = prologueEntry?.data;

const epilogueEntry = await getEntry("story", "epilogue");
const EpilogueBody = epilogueEntry ? (await render(epilogueEntry)).Content : null;
const epilogue = epilogueEntry?.data;

function resolveImgSrc(pathStr?: string): string {
  if (!pathStr) return "";
  if (pathStr.startsWith("/")) return pathStr;
  return pathStr.replace("../data/images/", "/images/").replace("../data/", "/");
}
---
<Base>
  <!-- 00 · OPENING COVER / PROLOGUE -->
  {prologue && (
    <section
      class="chapter prologue is-active"
      id="prologue"
      data-chapter
      data-label="Origin"
      data-act="moon"
      data-distance="0"
      data-light="0"
    >
      <div class="prologue-inner">
        <p class="cover-eyebrow" data-reveal>Thirteen Silent Spacecraft Across the Solar System</p>

        <div class="cover-title-lockup" data-reveal>
          <h1 class="cover-title">STILL</h1>
          <p class="cover-subtitle">Abandoned, Not Forgotten</p>
        </div>

        <blockquote class="prologue-voice" data-split>
          {prologue.voice.map((line) => (
            <p>{line}</p>
          ))}
        </blockquote>

        {PrologueBody && (
          <div class="story-prose prologue-prose" data-reveal>
            <div class="narration">
              <PrologueBody />
            </div>
          </div>
        )}

        <div class="prologue-actions" data-reveal>
          <button
            type="button"
            class="btn-orbital is-primary"
            data-nav-dir="next"
            data-target-act="moon"
            data-scroll-target="apollo-lunar-modules"
          >
            <span>{prologue.legacyLine}</span>
            <svg class="btn-vec" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <button
            type="button"
            class="btn-orbital"
            data-nav-dir="next"
            data-target-act="deep"
            data-scroll-target="chapters"
          >
            <span>Chapters</span>
          </button>
        </div>
      </div>
    </section>
  )}

  <!-- PURE-BLACK (#000000) MINIMAL CHAPTERS INDEX -->
  <section
    class="chapter chapters-page"
    id="chapters"
    data-chapter
    data-label="Chapters"
    data-act="moon"
    data-distance="0"
    data-light="0"
  >
    <div class="obsidian-wrap">
      <header class="obsidian-head" data-reveal>
        <h1 class="obs-title">Chapters</h1>
        <p class="obs-sub">Thirteen silent machines from the Moon to interstellar space</p>
      </header>

      <div class="obs-ledger">
        {ACT_META.map((sector) => {
          const sectorItems = chapters
            .map((item, globalIdx) => ({ ...item, chNumber: globalIdx + 1 }))
            .filter((item) => item.a.act === sector.key);

          return (
            <section class="obs-sector">
              <div class="obs-sector-bar" data-target-act={sector.key}>
                <span class="sector-name">{sector.title}</span>
                <span class="sector-delay">{sector.delay}</span>
              </div>

              <ol class="obs-list">
                {sectorItems.map(({ a, story, chNumber }) => {
                  const padNum = String(chNumber).padStart(2, "0");
                  return (
                    <li class="obs-item" data-target-act={a.act}>
                      <button
                        type="button"
                        class="obs-row"
                        data-scroll-target={a.slug}
                      >
                        <span class="obs-num">{padNum}</span>
                        <span class="obs-name">{a.nickname ?? a.name}</span>
                        {story?.hook && <span class="obs-hook">“{story.hook}”</span>}
                        <span class="obs-arrow" aria-hidden="true">→</span>
                      </button>
                    </li>
                  );
                })}
              </ol>
            </section>
          );
        })}
      </div>

      <footer class="obs-foot" data-reveal>
        <button type="button" class="obs-foot-link" data-scroll-target="prologue">← Opening Cover</button>
        <div class="obs-foot-right">
          <button type="button" class="obs-foot-link" data-scroll-target="epilogue">Epilogue</button>
          <button type="button" class="obs-foot-link" data-scroll-target="archive">NSSDCA Archive</button>
        </div>
      </footer>
    </div>
  </section>

  <!-- 01..13 · MISSION STORY CHAPTERS -->
  {chapters.map(({ a, story, Body }, idx) => {
    const hasBothImages = Boolean(a.images.then && a.images.now);
    const prevItem = idx > 0 ? chapters[idx - 1] : null;
    const nextItem = idx < chapters.length - 1 ? chapters[idx + 1] : null;

    return (
      <section
        class="chapter"
        id={a.slug}
        data-chapter
        data-label={a.nickname ?? a.name}
        data-act={a.act}
        data-distance={a.distanceKm}
        data-light={a.lightTimeSec}
      >
        <ChapterHero
          name={a.name}
          nickname={a.nickname}
          hook={story?.hook ?? ""}
          act={a.act}
          index={idx + 1}
          total={chapters.length}
          mission={a.mission}
          site={a.location.site}
          distanceKm={a.distanceKm}
          lightTimeSec={a.lightTimeSec}
        />

        <!-- 1. The Spacecraft's First-Person Voice -->
        {story && (
          <VoiceBlock
            lines={story.voice}
            truthNote={story.truthNote}
          />
        )}

        <!-- 2. Long-Form Narrative Story -->
        {Body && (
          <article class="story-prose" data-reveal>
            <div class="narration">
              <Body />
            </div>
          </article>
        )}

        <!-- 3. NASA Archival Photograph / Then & Now Comparison -->
        {hasBothImages ? (
          <ThenNowSlider
            thenImg={{ ...a.images.then!, src: resolveImgSrc(a.images.then!.src) }}
            nowImg={{ ...a.images.now!, src: resolveImgSrc(a.images.now!.src) }}
            title={a.nickname ?? a.name}
          />
        ) : a.images.then ? (
          <div class="chapter-imagery" data-reveal>
            <figure class="single-image-card">
              <div class="image-wrapper">
                <img
                  src={resolveImgSrc(a.images.then.src)}
                  alt={a.images.then.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="image-caption">
                <span class="caption-text">{a.images.then.alt}</span>
                <span class="caption-credit">{a.images.then.credit}</span>
              </figcaption>
            </figure>
          </div>
        ) : null}

        <!-- 4. Interactive Experiment Moment (where applicable) -->
        {a.slug === "alsep" && (
          <PingTheMoon lightTimeSec={a.lightTimeSec} />
        )}

        {a.slug === "spirit-opportunity" && (
          <SolOdometer
            planned={a.planned?.value}
            actual={a.actual?.value}
            unit={a.planned?.unit}
          />
        )}

        {a.slug === "ingenuity" && (
          <FlightCounter
            planned={a.planned?.value}
            actual={a.actual?.value}
          />
        )}

        {a.slug === "pioneer" && (
          <SendAMessage
            lightTimeSec={a.lightTimeSec}
            targetName={a.name}
          />
        )}

        <!-- 5. Legacy Takeaway -->
        {story?.legacyLine && (
          <p class="chapter-legacy" data-reveal>
            “{story.legacyLine}”
          </p>
        )}

        <!-- 6. Quiet Archival Colophon -->
        <RecordCard
          stats={a.stats}
          lastContact={a.lastContact}
          site={a.location.site}
          nssdcaId={a.nssdcaId}
          nssdcaUrl={a.nssdcaUrl}
          legacy={a.legacy}
        />

        <!-- 7. Minimal Chapter Turn -->
        <nav class="chapter-pager" aria-label="Chapter pagination">
          {prevItem ? (
            <button
              type="button"
              class="pager-link prev"
              data-nav-dir="prev"
              data-target-act={prevItem.a.act}
              data-scroll-target={prevItem.a.slug}
            >
              <span class="pager-dir">← Chapter {String(idx).padStart(2, "0")}</span>
              <span class="pager-name">{prevItem.a.nickname ?? prevItem.a.name}</span>
            </button>
          ) : (
            <button
              type="button"
              class="pager-link prev"
              data-nav-dir="prev"
              data-target-act="moon"
              data-scroll-target="prologue"
            >
              <span class="pager-dir">← Cover</span>
              <span class="pager-name">Opening Prologue</span>
            </button>
          )}

          {nextItem ? (
            <button
              type="button"
              class="pager-link next"
              data-nav-dir="next"
              data-target-act={nextItem.a.act}
              data-scroll-target={nextItem.a.slug}
            >
              <span class="pager-dir">Chapter {String(idx + 2).padStart(2, "0")} →</span>
              <span class="pager-name">{nextItem.a.nickname ?? nextItem.a.name}</span>
            </button>
          ) : (
            <button
              type="button"
              class="pager-link next"
              data-nav-dir="next"
              data-target-act="deep"
              data-scroll-target="epilogue"
            >
              <span class="pager-dir">Closing →</span>
              <span class="pager-name">Epilogue</span>
            </button>
          )}
        </nav>
      </section>
    );
  })}

  <!-- 14 · EPILOGUE -->
  {epilogue && (
    <section
      class="chapter epilogue"
      id="epilogue"
      data-chapter
      data-label="Epilogue"
      data-act="deep"
      data-distance="24000000000"
      data-light="80000"
    >
      <div class="epilogue-container">
        <header class="epilogue-header" data-reveal>
          <span class="epilogue-kicker">Epilogue</span>
          <h1 class="epilogue-title">{epilogue.hook}</h1>
        </header>

        <VoiceBlock lines={epilogue.voice} />

        {EpilogueBody && (
          <article class="story-prose" data-reveal>
            <div class="narration">
              <EpilogueBody />
            </div>
          </article>
        )}

        <p class="chapter-legacy" data-reveal>
          “{epilogue.legacyLine}”
        </p>

        <nav class="chapter-pager" aria-label="Chapter pagination">
          <button
            type="button"
            class="pager-link prev"
            data-nav-dir="prev"
            data-target-act="deep"
            data-scroll-target="kepler"
          >
            <span class="pager-dir">← Chapter 13</span>
            <span class="pager-name">Kepler Space Telescope</span>
          </button>

          <button
            type="button"
            class="pager-link next"
            data-nav-dir="next"
            data-target-act="deep"
            data-scroll-target="archive"
          >
            <span class="pager-dir">Registry →</span>
            <span class="pager-name">The Silent Fleet Archive</span>
          </button>
        </nav>
      </div>
    </section>
  )}

  <!-- 15 · ARCHIVE -->
  <section
    id="archive"
    class="chapter archive"
    data-chapter
    data-label="Archive"
    data-act="deep"
    data-distance="0"
    data-light="0"
  >
    <div class="archive-inner">
      <div class="archive-header" data-reveal>
        <span class="archive-kicker">Master Index</span>
        <h1>The Silent Fleet Archive</h1>
        <p class="archive-sub">
          Verified NSSDCA historical registry of the thirteen missions featured in STILL.
        </p>
      </div>

      <div class="archive-table-wrapper" data-reveal>
        <table class="archive-table" id="archive-table">
          <thead>
            <tr>
              <th>Spacecraft</th>
              <th>Body</th>
              <th>Mission</th>
              <th>Last Contact</th>
              <th>Record</th>
            </tr>
          </thead>
          <tbody>
            {artifacts.map((a) => (
              <tr data-act={a.act} data-slug={a.slug} class="archive-row">
                <td class="name-col">
                  <a href={`#${a.slug}`} class="archive-link" data-scroll-slug={a.slug}>{a.nickname ?? a.name}</a>
                </td>
                <td><span class={`body-tag tag-${a.act}`}>{a.location.body}</span></td>
                <td class="mission-col">{a.mission}</td>
                <td class="contact-col">{a.lastContact}</td>
                <td class="chip-col">
                  <CitationChip href={a.nssdcaUrl} label={`NSSDCA ${a.nssdcaId}`} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <footer class="archive-footer">
        <p class="credit">
          Imagery, coordinates, and historical records courtesy of NASA / JPL-Caltech / Arizona State University / Goddard Space Flight Center (NSSDCA).
        </p>
      </footer>
    </div>
  </section>
</Base>

<script>
  import { scrollToChapter } from "../scripts/engine";

  document.querySelectorAll<HTMLElement>("[data-scroll-target]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.scrollTarget;
      if (target) scrollToChapter(target);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-scroll-slug]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const slug = link.dataset.scrollSlug;
      if (slug) scrollToChapter(slug);
    });
  });
</script>

<style>
  /* ==========================================================
     00 · OPENING COVER / PROLOGUE
     ========================================================== */
  .prologue {
    padding: var(--s-20) var(--s-6) var(--s-24);
  }

  .prologue-inner {
    max-width: var(--measure);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s-10);
  }

  .cover-eyebrow {
    margin: 0;
    font: 400 var(--t-xs)/1.4 var(--f-record);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
  }

  .cover-title-lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
  }

  .cover-title {
    font: 700 clamp(3.4rem, 2.4rem + 5vw, 6.2rem)/1 var(--f-voice);
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    margin: 0;
    color: var(--c-ink);
  }

  .cover-subtitle {
    font: 400 var(--t-xs)/1.5 var(--f-record);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ink-dim);
    margin: 0;
  }

  .prologue-voice {
    max-width: 48ch;
    margin: 0;
    padding: var(--s-8) 0;
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
  }
  .prologue-voice p {
    font: italic 400 var(--t-lg)/var(--lh-voice) var(--f-voice);
    margin: 0 0 var(--s-4);
    color: var(--c-ink);
  }
  .prologue-voice p:last-child {
    margin-bottom: 0;
    font-style: normal;
    color: var(--c-accent);
  }

  .prologue-prose {
    margin-block: 0;
    padding-inline: 0;
    text-align: left;
  }

  .prologue-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-4);
    padding-top: var(--s-2);
  }

  /* ==========================================================
     PURE-BLACK (#000000) MINIMAL CHAPTERS INDEX PAGE
     ========================================================== */
  .chapters-page {
    background-color: #000000;
    color: #f2efe9;
    min-height: calc(100vh - 56px);
    padding: var(--s-20) var(--s-6) var(--s-24);
  }

  .obsidian-wrap {
    max-width: 780px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-16);
  }

  .obsidian-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .obs-title {
    font: 700 var(--t-xl)/1.15 var(--f-voice);
    letter-spacing: -0.015em;
    margin: 0;
    color: #f2efe9;
  }

  .obs-sub {
    margin: 0;
    font: 400 var(--t-xs)/1.5 var(--f-record);
    letter-spacing: 0.06em;
    color: #7c776e;
  }

  .obs-ledger {
    display: flex;
    flex-direction: column;
    gap: var(--s-12);
  }

  .obs-sector {
    display: flex;
    flex-direction: column;
  }

  .obs-sector-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--s-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    font: 400 var(--t-xs)/1 var(--f-record);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sector-name {
    color: var(--btn-accent, #d4c6ab);
  }
  .sector-delay {
    color: #6a655d;
  }

  .obs-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .obs-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .obs-row {
    appearance: none;
    width: 100%;
    background: transparent;
    border: 0;
    padding: 20px 0;
    display: grid;
    grid-template-columns: 36px minmax(180px, 1.1fr) 1.4fr 20px;
    align-items: baseline;
    gap: var(--s-4);
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition: opacity var(--d-fast);
  }

  .obs-num {
    font: 400 var(--t-xs)/1 var(--f-record);
    letter-spacing: 0.08em;
    color: #6a655d;
    font-variant-numeric: tabular-nums;
    transition: color var(--d-fast);
  }
  .obs-row:hover .obs-num {
    color: var(--btn-accent, #d4c6ab);
  }

  .obs-name {
    font: 700 var(--t-sm)/1.35 var(--f-voice);
    color: #f2efe9;
    transition: color var(--d-fast);
  }
  .obs-row:hover .obs-name {
    color: var(--btn-accent, #d4c6ab);
  }

  .obs-hook {
    font: italic 400 var(--t-xs)/1.5 var(--f-voice);
    color: #8c877d;
  }

  .obs-arrow {
    text-align: right;
    color: #6a655d;
    transition: transform var(--d-fast) var(--ease-spring), color var(--d-fast);
  }
  .obs-row:hover .obs-arrow {
    transform: translateX(4px);
    color: #f2efe9;
  }

  .obs-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--s-6);
    border-top: 1px solid rgba(255, 255, 255, 0.10);
  }
  .obs-foot-right {
    display: inline-flex;
    gap: var(--s-6);
  }
  .obs-foot-link {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: 400 var(--t-xs)/1 var(--f-record);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7c776e;
    cursor: pointer;
    transition: color var(--d-fast);
  }
  .obs-foot-link:hover {
    color: #f2efe9;
  }

  /* ==========================================================
     CHAPTER IMAGERY, LEGACY LINE & MINIMAL PAGINATION
     ========================================================== */
  .chapter-imagery {
    max-width: var(--measure);
    margin: var(--s-12) auto var(--s-16);
    padding-inline: var(--s-6);
  }
  .single-image-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--r-sm);
    border: 1px solid var(--c-line);
    background: #050507;
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.55) contrast(1.02);
    transition: filter var(--d-base) var(--ease-out);
  }
  .single-image-card:hover .image-wrapper img {
    filter: saturate(1) contrast(1);
  }
  .image-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    font: 400 var(--t-xs)/1.5 var(--f-record);
    color: var(--c-ink-dim);
  }
  .caption-credit {
    opacity: 0.7;
  }

  .chapter-legacy {
    max-width: var(--measure);
    margin: var(--s-16) auto;
    padding: 0 var(--s-6);
    text-align: center;
    font: italic 400 var(--t-lg)/var(--lh-voice) var(--f-voice);
